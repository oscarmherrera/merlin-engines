[Unit]
Description=merlin-endpoint: Ternary-Bonsai-2-27B-PQ2_0 (CUDA sm_75, Quadro RTX 8000, :8081)
After=network-online.target
Wants=network-online.target

# Experimental engine 1e148d0; installed with its endpoint and runtime bundle.
[Service]
Type=simple
Environment=YZMA_LIB=/opt/merlin/lib/merlin-engines-1e148d0
Environment=LD_LIBRARY_PATH=/opt/merlin/lib/merlin-engines-1e148d0
ExecStartPre=/usr/local/sbin/wait-for-gpu.sh nvidia 180
ExecStart=/usr/local/libexec/merlin-engine-endpoint \
  --model /model/Ternary-Bonsai-2-27B-PQ2_0.gguf \
  --alias bonsai-2-27b \
  --addr :8081 \
  --ctx-size 262144 \
  --parallel 4 \
  --n-gpu-layers 999 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --batch-size 4096 \
  --ubatch-size 2048 \
  --prefix-reuse \
  --lib /opt/merlin/lib/merlin-engines-1e148d0
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
