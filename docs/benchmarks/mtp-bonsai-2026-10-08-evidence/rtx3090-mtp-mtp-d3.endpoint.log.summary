ensorTypeUInt64 TensorType = 9\n\t// TensorTypeFloat64 is a 64-bit float.\n\tTensorTypeFloat64 TensorType = 10\n\t// TensorTypeBF16 is a 16-bit bfloat.\n\tTensorTypeBF16 TensorType = 11\n)\n\n// TensorInfo describes a single tensor in the GGUF file.\ntype TensorInfo struct {\n\tName    string\n\tDims    []int64\n\tType    TensorType\n\tOffset  int64\n\tElements int64\n}\n\n// MetadataValue is a typed value for a metadata key.\ntype MetadataValue interface{}\n\n// Metadata is a map of key to typed value.\ntype Metadata map[string]MetadataValue\n\n// GGUFHeader describes the parsed header of a GGUF file.\ntype GGUF"}
